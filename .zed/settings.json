{
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "!deno", "!typescript-language-server", "!eslint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "!deno", "!typescript-language-server", "!eslint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "language_servers": ["vtsls", "!deno", "!typescript-language-server", "!eslint"]
    },
    "Vue.js": {
      "language_servers": [
        "vue-language-server",
        "vtsls",
        "tailwindcss-language-server",
        "!eslint"
      ],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
