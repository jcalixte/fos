      ]
    },
    {
      "id": "austrian",
      "name": "Austrian",
      "colour": "#e3e7ef",
      "brief": "The Alpone is your line and Arcole is the lock on it. The battery in the village reaches nine hundred metres back down the Arcole dike, which is the only fast road the French have, so make them use it or make them wade. Your own weight is on the east bank where horse is worth having, and a second column comes down the Porcile dike in the north-west toward their bridgehead at Ronco — that bridgehead is counted at the end too, and it is behind them. Watch the Albaredo road south of the village.",
      "roster": "/rosters/austrian-arcole.json",
