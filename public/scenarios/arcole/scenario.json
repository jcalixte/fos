  "armies": [
    {
      "id": "french",
      "name": "French",
      "colour": "#2f4d8f",
      "brief": "Get to the bridge at Arcole, which is at the far end of a causeway the guns in the village are laid along. You can go fast in column and arrive as a target, or come off the dike into the marsh and arrive late; the campi are the only ground in the fork worth forming on. Guieu is marching round by Albaredo and comes up the east bank behind the village three-quarters of the way through the afternoon — the village has to still be worth taking when he does. Do not lose the bridgehead at Ronco behind you: it is counted at the end exactly as the bridge is.",
      "roster": "/rosters/french-arcole.json",
      "headquarters": {
        "x": 484,
        "y": 788
      },
