{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "types": ["node", "@types/bun"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@/*": ["./src/*"] }
  },
  /* The simulation, the Scenario loader and the session's own vocabulary are
     imported whole, so they are part of this project too — the server is the
     authority and is checked against the same source the browser bundles. The
     rest of `src/` is a Vue app and has no business here. */
  "include": [
    "server/**/*.ts",
    "src/sim/**/*.ts",
    "src/scenario/**/*.ts",
    "src/scenario/png.mjs",
    "src/session/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
